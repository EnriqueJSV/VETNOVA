<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<connectionStrings>
		<add name ="WIN_AUT" providerName="System.Data.SqlClient" connectionString="Data Source=.;Initial Catalog=VetNova;Integrated Security=true;" />
		<add name ="SQL_AUT" providerName="System.Data.SqlClient" connectionString="Data Source=.;Initial Catalog=VetNova;Persist Security Info=true;User ID=sa;Password=" />
	</connectionStrings>
	<appSettings>

		<add key="SP_LOGIN_Usuarios" value="dbo.SP_INICIAR_SESION" />
		<add key="SP_INFO_USUARIOS" value="dbo.SP_INFO_USUARIOS" />
		
	</appSettings>
</configuration>