<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<connectionStrings>
		<add name ="WIN_AUT" providerName="System.Data.SqlClient" connectionString="Data Source=.;Initial Catalog=VetNova;Integrated Security=true;" />
		<add name ="SQL_AUT" providerName="System.Data.SqlClient" connectionString="Data Source=.;Initial Catalog=VetNova;Persist Security Info=true;User ID=sa;Password=Nosara" />
	</connectionStrings>
	<appSettings>

		<add key="SP_LOGIN_Usuarios" value="dbo.SP_INICIAR_SESION" />
		<add key="SP_CERRAR_Sesion" value="SP_CERRAR_SESION" />
		
		<add key="SP_INFO_USUARIOS" value="dbo.SP_INFO_USUARIOS" />
		
		
		<add key="SP_CONTAR_CITAS" value="dbo.SP_CONTAR_CITAS" />
		<add key="SP_LISTAR_CitasHoy" value="SP_LISTAR_CITAS_HOY" />


		<add key="SP_CONTAR_Mascotas" value="SP_CONTAR_MASCOTAS" />

		<add key="SP_CONTAR_Propietarios" value="SP_CONTAR_PROPIETARIOS" />

		<add key="SP_CONTAR_Veterinarios" value="SP_CONTAR_VETERINARIOS" />


		<add key="SP_LISTAR_Citas" value="SP_LISTAR_CITAS" />
		<add key="SP_LISTAR_Propietarios" value="SP_LISTAR_PROPIETARIOS" />
		<add key="SP_LISTAR_Veterinarios" value="SP_LISTAR_VETERINARIOS" />
		<add key="SP_LISTAR_Mascotas" value="SP_LISTAR_MASCOTAS" />
		
		
		<add key="SP_INSERTA_Citas" value="SP_INSERTA_CITAS" />

	</appSettings>
</configuration>